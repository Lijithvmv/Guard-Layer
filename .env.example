# GuardLayer needs no keys or configuration to run. All settings below are optional.

# Path to a TOML/JSON config (see examples/guardlayer.toml)
# GUARDLAYER_CONFIG=guardlayer.toml

# Require `X-API-Key: <value>` on every /v1 REST endpoint
# GUARDLAYER_API_KEY=

# Override the [guard] section of the config
# GUARDLAYER_FLAG_THRESHOLD=0.4
# GUARDLAYER_BLOCK_THRESHOLD=0.8
# GUARDLAYER_FAIL_CLOSED=false
# GUARDLAYER_AUTO_LEARN=false
